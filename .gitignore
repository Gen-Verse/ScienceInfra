__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/

# Run artifacts. Checkpoints, Harbor job directories, and PSRL logs are large.
outputs/
ckpts/
psrl_logs/
*.log

# Built datasets. `extra_info.task_path` is an absolute path to the compiled task
# bank on the machine that ran `prepare_all.sh`, so a parquet is never portable.
data/

# Local planning notes, not part of the published package.
NOTES-roadmap.md

# Compiled Harbor tasks. `demo/build/` is regenerated by to_harbor.py and its
# absolute paths are machine-local, so it is never portable.
demo/build/

# Binary case inputs: vendored upstream archives, MITgcm restart files, and the
# gridded forcing fields. All are large and reproducible. `env/source/source.json`
# pins the origin URL, commit, and sha256, so `demo/README.md` explains how to
# restore them. LAPS needs none of this and runs from a clean checkout.
demo/envs/*/env/source/*.tar.gz
demo/envs/*/env/cases/*/input/pickup*
demo/envs/*/env/cases/*/input/*.bin
demo/envs/*/env/cases/*/input/*.data
